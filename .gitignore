# =============================================================================
#  NutriFit-AI - .gitignore
#  CSE6035 Development Project (WRIT1) - U.L.S.R. Perera - CL.BSCSD.34.69
#
#  Principle: the repository must be (a) safe - no credentials, ever, and
#  (b) self-contained - a marker can clone it and run the system without
#  re-downloading anything except the two optional bulk datasets below.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. SECRETS  -  never commit, no exceptions
# -----------------------------------------------------------------------------
# backend/.env currently holds a live Supabase service_role key, which bypasses
# Row Level Security entirely. If it is ever committed it must be treated as
# compromised and rotated in the Supabase dashboard.
#
# Ignore every .env variant, then explicitly allow the committed templates.
.env
.env.*
!.env.example
!.env.template
!.env.sample

*.pem
*.key
*.p12
*.pfx
kaggle.json
secrets.json
credentials.json
service-account*.json


# -----------------------------------------------------------------------------
#  2. DEPENDENCIES  -  restored with `npm install` / `pip install -r`
# -----------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp.*
.yarn/

.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Lock files ARE committed - they pin the exact dependency tree that the
# submitted results were produced with, which is part of reproducibility.
# (package-lock.json, requirements.txt are deliberately NOT listed here.)


# -----------------------------------------------------------------------------
#  3. BUILD OUTPUT  -  regenerated by `npm run build`
# -----------------------------------------------------------------------------
dist/
build/
out/
.vite/
.cache/
*.tsbuildinfo


# -----------------------------------------------------------------------------
#  4. PYTHON / JUPYTER CACHES
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage/
htmlcov/
.tox/
.nox/


# -----------------------------------------------------------------------------
#  5. DATA
# -----------------------------------------------------------------------------
# data/raw/          COMMITTED (112 KB total). Small enough that keeping them
#                    makes the whole pipeline reproducible from a clone.
#                    If a dataset licence forbids redistribution, uncomment the
#                    two lines below and rely on data/raw/README.md instead.
# data/raw/*
# !data/raw/README.md

# data/processed/    COMMITTED (0.5 MB). foods_seed.sql is needed to populate
#                    Supabase, and the labelled dataset is the exact input the
#                    reported metrics came from.

# data/external/     IGNORED (48 MB). USDA FoodData Central bulk download.
#                    Public domain and re-downloadable; optional enrichment
#                    only - the system runs fine without it.
data/external/*
!data/external/README.md
!data/external/.gitkeep


# -----------------------------------------------------------------------------
#  6. ML ARTEFACTS
# -----------------------------------------------------------------------------
# Trained models ARE committed so the FastAPI service and the Node backend run
# straight from a clone - the marker should not have to retrain to see it work.
#
# Intermediate training bundles are not: they are regenerated by train.py and
# add ~6 MB of duplicate data.
ml/artifacts/_*_bundle.pkl
ml/artifacts/**/checkpoints/

# ml/reports/figures/  COMMITTED. These are the training graphs used as
#                      evidence in the dissertation, so they belong in the
#                      submitted history.


# -----------------------------------------------------------------------------
#  7. OFFICE / DOCUMENT TEMPORARIES
# -----------------------------------------------------------------------------
# Word writes a ~$Name.docx lock file whenever a document is open. Committing
# one is a classic accident in a dissertation repo.
~$*
*.tmp
*.temp
.~lock.*#


# -----------------------------------------------------------------------------
#  8. LOGS AND RUNTIME NOISE
# -----------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed


# -----------------------------------------------------------------------------
#  9. EDITORS AND OPERATING SYSTEM
# -----------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.claude/

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
#  10. LOCAL SCRATCH
# -----------------------------------------------------------------------------
.tmp/
scratch/
sandbox/
*.bak
*.orig
*.rej
