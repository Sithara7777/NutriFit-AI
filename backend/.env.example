# Copy to backend/.env and fill in your values.
# NEVER commit the real .env — it is listed in .gitignore.

NODE_ENV=development
PORT=4000

# --- Supabase -------------------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: bypasses Row Level Security. Used ONLY for seeding the
# shared food catalogue, never to serve a user request. Server-side only —
# putting this in the frontend would expose every user's data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Python ML microservice ----------------------------------------------
# Internal address only. This service must never be exposed to the internet.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=20000
ML_SERVICE_PLAN_TIMEOUT_MS=120000

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Business rules -------------------------------------------------------
# Fractional change in calorie/protein target that prompts the user to
# regenerate their meal plan (0.07 = 7%).
DRIFT_THRESHOLD=0.07
